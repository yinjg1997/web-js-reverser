{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "moduleResolution": "node",
    "module": "commonjs",
    "maxNodeModuleJsDepth": 2
  },
  "include": ["**/*.js", "**/*.cjs", "**/*.mjs"],
  "exclude": ["node_modules", "dist", "build", "outputs"]
}
